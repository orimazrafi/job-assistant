{
  "name": "@job-assistant/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "db:migration:new": "node-pg-migrate create -m migrations -j sql"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@bull-board/nestjs": "^9.10.4",
    "@job-assistant/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.3.13",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/mongodb": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "vitest": "^5.0.4"
  }
}
