# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://job:job@localhost:5433/job_assistant
MONGO_URL=mongodb://localhost:27017/job_assistant
REDIS_URL=redis://localhost:6379
# Optional. Session ends after this long without use (default 7 days) / after login (default 30 days).
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Queue dashboard at /api/queues. Off unless "true"; never mounted when NODE_ENV=production.
QUEUE_DASHBOARD_ENABLED=true
